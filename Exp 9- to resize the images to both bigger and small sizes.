import cv2

image = cv2.imread(r"C:\Users\Papireddy\OneDrive\certificates\ITA0527\Screenshot 2026-02-27 151152.png")

if image is None:
    print("Error: Image not found!")
else:
    small = cv2.resize(image, None, fx=0.5, fy=0.5)
    big = cv2.resize(image, None, fx=1.5, fy=1.5)

    cv2.imshow("Original Image", image)
    cv2.imshow("Smaller Image", small)
    cv2.imshow("Bigger Image", big)

    cv2.waitKey(0)
    cv2.destroyAllWindows()
